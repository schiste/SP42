# syntax=docker/dockerfile:1.7
FROM rust:1.96.0-bookworm AS builder

ARG TAURI_CLI_VERSION=2.10.1
ARG TRUNK_VERSION=0.21.14
ARG USERNAME=dev
ARG UID=1000
ARG GID=1000

RUN groupadd --gid "$GID" "$USERNAME" \
    && useradd \
        --uid "$UID" \
        --gid "$GID" \
        --create-home \
        --shell /bin/bash \
        "$USERNAME"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        vim \
        git \
        libssl-dev \
        pkg-config \
        libwebkit2gtk-4.1-dev \
        libsoup-3.0-dev \
        libjavascriptcoregtk-4.1-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        patchelf \
    && rm -rf /var/lib/apt/lists/*

USER "$USERNAME"

RUN rustup target add wasm32-unknown-unknown \
    && cargo install tauri-cli --locked --version "${TAURI_CLI_VERSION}" \
    && cargo install trunk --locked --version "${TRUNK_VERSION}" \
    && cargo install --locked \
        cargo-deny \
        cargo-audit \
        cargo-llvm-cov

WORKDIR /src

# The repository build task compiles both the Axum server and the Trunk/Wasm app.
ENV SP42_USE_SCCACHE=0

CMD ["/bin/bash"]
